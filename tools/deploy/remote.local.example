# Скопируйте в tools/deploy/remote.local и заполните.
# remote.local не коммитится.

# Куда подключаться по SSH.
TARGET=user@203.0.113.10

# Порт SSH, если не 22.
# SSH_PORT=2222

# Пароль SSH.
# ask — спросить при подключении, file — взять SSH_PASSWORD и не спрашивать ничего.
# В режиме file тот же пароль уходит и в sudo. Символ # в пароле не обрезается.
SSH_PASSWORD_MODE=ask
SSH_PASSWORD=

# Аргументы install-ubuntu.sh. Строка — флаг и, если нужно, значение.
# --domain example.com
# --port 8000
# --branch main
# --no-nginx
# --no-ufw
